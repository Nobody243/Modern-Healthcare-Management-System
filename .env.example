DB_USER=your_oracle_user
DB_PASSWORD=your_oracle_password
DB_CONNECTION_STRING=your_connection_string
JWT_SECRET=replace_with_a_strong_random_secret

# Optional if you use Oracle thick client
# ORACLE_LIB_DIR=path_to_oracle_client

# App URL used by auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional if you use NextAuth-style environment variables elsewhere
# NEXTAUTH_SECRET=replace_with_a_strong_random_secret
# NEXTAUTH_URL=http://localhost:3000

# Oracle Autonomous DB Keep-Alive (GitHub Secrets)
# ORACLE_USER=admin
# ORACLE_PASSWORD=your_secure_db_password
# ORACLE_WALLET_BASE64=your_base64_encoded_wallet_zip
# ORACLE_WALLET_PASSWORD=your_wallet_encryption_password
# ORACLE_TNS_NAME=your_db_low_or_high_alias